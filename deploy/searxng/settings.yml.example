use_default_settings: true
server:
  secret_key: "GENERATE_ME_openssl_rand_hex_16"
  limiter: false   # localhost-only binding; our agents ARE the intended clients
  image_proxy: false
search:
  formats:
    - html
    - json
engines:
  # Defaults leave only DuckDuckGo/Brave active for general search; more upstreams = no single point of failure.
  - name: google
    disabled: false
  - name: bing
    disabled: false
  - name: yahoo
    disabled: false
  - name: mojeek
    disabled: false
    inactive: false
