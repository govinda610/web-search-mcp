# copy to .env and fill in — NEVER commit .env
# Only SEARXNG_URL is needed for fully local use; every key below is an optional fallback.
SEARXNG_URL=http://localhost:8888
# 0 = never open a visible browser window for DataDome-protected sites
FETCH_VISIBLE_BROWSER=1
# Your own Chrome (started with --remote-debugging-port) for logged-in sites; empty = skip
CHROME_CDP_URL=
# Tor SOCKS proxy for sites your ISP blocks
TOR_PROXY=socks5h://127.0.0.1:9050
JINA_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# Allow fetching private/local addresses (off by default: pages can carry prompt injections)
FETCH_ALLOW_PRIVATE=
# Free Z-Library account, used by book_download when LibGen fails
ZLIB_EMAIL=
ZLIB_PASSWORD=
# Contact address Unpaywall asks for (no key); finds open-access copies of papers
UNPAYWALL_EMAIL=
# EDGAR requires a contact in the User-Agent, e.g. "Your Name you@example.com"
SEC_USER_AGENT=
# Country for "where is it streaming" in media_search (ISO code)
WATCH_COUNTRY=IN
# How often the HTTP server checks release_watch entries
WATCH_INTERVAL_HOURS=6
# 1 = let downloads go anywhere, not just non-hidden folders under your home
DOWNLOAD_ALLOW_ANY_DIR=
# Your own indexers, if you run them
PROWLARR_URL=
PROWLARR_API_KEY=
JACKETT_URL=
JACKETT_API_KEY=
